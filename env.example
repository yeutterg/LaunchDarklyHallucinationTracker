# LaunchDarkly Configuration
LAUNCHDARKLY_SDK_KEY=sdk-your-launchdarkly-sdk-key-here
LAUNCHDARKLY_AI_CONFIG_KEY=your-main-ai-config-key
LAUNCHDARKLY_LLM_JUDGE_KEY=your-llm-as-judge-ai-config-key

# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key

# Optional: AWS Session Token (if using temporary credentials)
# AWS_SESSION_TOKEN=your-aws-session-token 